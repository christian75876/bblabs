      const y = window.scrollY * 0.15; // factor parallax
      bg.style.transform = `translateY(${y}px)`;
      ticking = false;
    });
  }
  window.addEventListener('scroll', onScroll, { passive: true });

  // Reveal on scroll: IntersectionObserver + Anime.js (on-demand)
  const items = document.querySelectorAll('.reveal');
  const io = new IntersectionObserver((entries) => {
    // Carga animejs solo cuando algo entra por primera vez
    const needsAnime = entries.some(e => e.isIntersecting);
    if (needsAnime) {
      import('animejs/lib/anime.es.js')
        .then(({ default: anime }) => {
          entries.forEach((entry, idx) => {
            if (!entry.isIntersecting) return;
            const el = entry.target;
            el.classList.add('is-visible'); // estado final por si falla animación
            anime({
              targets: el,
              opacity: [0, 1],
              translateY: [24, 0],
              duration: 600,
              delay: idx * 60,
              easing: 'easeOutQuad'
            });
            io.unobserve(el);
          });
        })
        .catch(() => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          });
        });
    }
  }, { threshold: 0.15 });

  items.forEach(el => io.observe(el));
</script> -->
