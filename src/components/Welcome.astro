---
import astroLogo from '../assets/astro.svg';
import background from '../assets/background.svg';
---

<div id="container">
  <!-- Fondo con parallax -->
  <img id="background" src={background.src} alt="" fetchpriority="high" />

  <main>
    <!-- HERO -->
    <section class="section" id="hero">
      <a href="https://astro.build">
        <img src={astroLogo.src} width="115" height="48" alt="Astro Homepage" />
      </a>

      <h1 class="reveal">
        To get started, open the <code><pre>src/pages</pre></code> directory in your project.
      </h1>

      <div id="links" class="reveal">
        <a class="button" href="https://docs.astro.build">Read our docs</a>
        <a href="https://astro.build/chat">
          Join our Discord
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 127.14 96.36">
            <path fill="currentColor" d="M107.7 8.07A105.15 105.15 0 0 0 81.47 0a72.06 72.06 0 0 0-3.36 6.83 97.68 97.68 0 0 0-29.11 0A72.37 72.37 0 0 0 45.64 0a105.89 105.89 0 0 0-26.25 8.09C2.79 32.65-1.71 56.6.54 80.21a105.73 105.73 0 0 0 32.17 16.15 77.7 77.7 0 0 0 6.89-11.11 68.42 68.42 0 0 1-10.85-5.18c.91-.66 1.8-1.34 2.66-2a75.57 75.57 0 0 0 64.32 0c.87.71 1.76 1.39 2.66 2a68.68 68.68 0 0 1-10.87 5.19 77 77 0 0 0 6.89 11.1 105.25 105.25 0 0 0 32.19-16.14c2.64-27.38-4.51-51.11-18.9-72.15ZM42.45 65.69C36.18 65.69 31 60 31 53s5-12.74 11.43-12.74S54 46 53.89 53s-5.05 12.69-11.44 12.69Zm42.24 0C78.41 65.69 73.25 60 73.25 53s5-12.74 11.44-12.74S96.23 46 96.12 53s-5.04 12.69-11.43 12.69Z" />
          </svg>
        </a>
      </div>

      <div class="scroll-indicator">scroll</div>
    </section>

    <!-- FEATURES -->
    <section class="section section--alt" id="features">
      <div class="container reveal">
        <h2>Features</h2>
        <p>
          Build ultra-fast sites with partial hydration, islands, and your favorite UI libraries.
        </p>
      </div>
    </section>

    <!-- SHOWCASE -->
    <section class="section" id="showcase">
      <div class="container reveal">
        <h2>Showcase</h2>
        <p>
          Bring visuals to life. Later aquí podemos montar Three.js como isla o canvas ligero.
        </p>
      </div>
    </section>

    <!-- CONTACT -->
    <section class="section section--alt" id="contact">
      <div class="container reveal">
        <h2>Contact</h2>
        <p>Let’s build something electric ⚡ together.</p>
      </div>
    </section>
  </main>

  <!-- News card (sticky-ish) -->
  <a href="https://astro.build/blog/astro-5/" id="news" class="box">
    <svg width="32" height="32" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M24.667 12c1.333 1.414 2 3.192 2 5.334 0 4.62-4.934 5.7-7.334 12C18.444 28.567 18 27.456 18 26c0-4.642 6.667-7.053 6.667-14Zm-5.334-5.333c1.6 1.65 2.4 3.43 2.4 5.333 0 6.602-8.06 7.59-6.4 17.334C13.111 27.787 12 25.564 12 22.666c0-4.434 7.333-8 7.333-16Zm-6-5.333C15.111 3.555 16 5.556 16 7.333c0 8.333-11.333 10.962-5.333 22-3.488-.774-6-4-6-8 0-8.667 8.666-10 8.666-20Z" fill="#111827" />
    </svg>
    <h2>What's New in Astro 5.0?</h2>
    <p>From content layers to server islands, click to learn more about the new features.</p>
  </a>
</div>

<style>
  /* ==== base / layout ==== */
  #background{
    position:fixed; inset:0; width:100%; height:100%;
    z-index:-1; filter:blur(100px); transform:translateY(0);
    will-change: transform;
  }
  #container{
    font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
    min-height:100vh; /* ✅ permite scroll real */
  }
  main{ min-height:100vh; display:block; }

  /* Secciones de pantalla completa */
  .section{
    min-height:100vh;
    display:grid;
    place-items:center;
    padding:6rem 1rem;
  }
  .section--alt{
    background: rgba(255,255,255,.66);
    backdrop-filter: blur(6px);
  }
  .container{
    max-width:960px;
    text-align:center;
  }

  /* Hero específico */
  #hero{ position:relative; }
  #hero h1{ font-size:clamp(22px, 3.2vw, 42px); margin-top:.25em; }
  #links{ display:flex; gap:16px; justify-content:center; flex-wrap:wrap; }
  #links a{
    display:flex; align-items:center; padding:10px 12px; color:#111827;
    text-decoration:none; transition:color .2s;
  }
  #links a:hover{ color:rgb(78,80,86); }
  #links a svg{ height:1em; margin-left:8px; }
  #links a.button{
    color:white;
    background: linear-gradient(83.21deg, #3245ff 0%, #bc52ee 100%);
    box-shadow: inset 0 0 0 1px rgba(255,255,255,.12), inset 0 -2px 0 rgba(0,0,0,.24);
    border-radius:10px;
  }
  #links a.button:hover{ color:#e6e6e6; box-shadow:none; }

  pre{
    font-family: ui-monospace, 'Cascadia Code', 'Source Code Pro', Menlo, Consolas, 'DejaVu Sans Mono', monospace;
    font-weight:normal;
    background: linear-gradient(14deg, #d83333 0%, #f041ff 100%);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
    margin:0;
  }

  /* Tarjeta news */
  .box{ padding:16px; background:#fff; border-radius:16px; border:1px solid #fff; }
  #news{
    position:sticky; bottom:16px; float:right; right:16px; max-width:300px;
    text-decoration:none; transition:background .2s; backdrop-filter: blur(50px); margin:16px;
  }
  #news:hover{ background: rgba(255,255,255,.55); }

  /* Indicador scroll */
  .scroll-indicator{
    position:absolute; bottom:24px; left:50%; transform:translateX(-50%);
    font-size:12px; letter-spacing:.2em; text-transform:uppercase; opacity:.7;
  }

  /* Reveal base */
  .reveal{ opacity:0; transform: translateY(24px); }
  .reveal.is-visible{ opacity:1; transform:none; }

  /* Responsivo */
  @media (max-width: 768px){
    #hero{ padding-top:10%; }
    #links a.button{ padding:14px 18px; }
    h1{ line-height:1.5; }
    #news{ right:16px; left:16px; bottom:2.5rem; max-width:100%; }
  }
  @media (max-height: 368px){ #news{ display:none; } }
</style>

