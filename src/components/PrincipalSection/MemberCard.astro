---
interface Props {
  name: string;
  role: string;
  image: string;
  description: string;
  linkText?: string;
  linkUrl?: string;
  align?: "left" | "right";
}

const {
  name,
  role,
  image,
  description,
  linkText = "",
  linkUrl = "#",
  align = "left",
} = Astro.props;

const backgroundText = name.split(" ")[0].toUpperCase();
---

<section
  class={`p-6 member-card relative w-full lg:h-[410px] bg-black text-white flex flex-col md:flex-row overflow-hidden ${
    align === "right" ? "md:flex-row-reverse" : ""
  }`}
>
  <div
    class="bg__text__member absolute inset-0 flex items-center pointer-events-none select-none opacity-[0.1] text-[20vw] md:text-[18vw] lg:text-[22vw]
 font-extrabold leading-none tracking-tight whitespace-nowrap transition-transform duration-[3800ms] ease-[cubic-bezier(0.22,1,0.36,1)]"
    style={`transform: translateX(${align === "right" ? "-40%" : "40%"});`}
  >
    {backgroundText}
  </div>

  <div
    class="flex w-full md:w-[40%] md:h-auto overflow-hidden items-center justify-center"
  >
    <img
      src={image}
      alt={name}
      class="h-full grayscale object-fill opacity-90 lg:absolute"
    />
  </div>

  <div
    class="relative z-10 w-full md:w-[60%] px-6 md:px-12 py-10 flex flex-col justify-center max-w-3xl"
  >
    <h2 class="text-5xl md:text-7xl font-bold mb-2">{name}</h2>

    <p class="text-xl font-semibold mb-6 text-primary">{role}</p>

    <p class="text-lg text-muted mb-8 leading-relaxed">{description}</p>

    {
      linkText && (
        <a href={linkUrl} class="text-lg underline hover:text-white transition">
          {linkText}
        </a>
      )
    }
  </div>
</section>
