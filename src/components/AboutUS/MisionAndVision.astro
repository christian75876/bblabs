---
import type { Dictionary } from "@/i18n/types";

type Props = {
  t: Dictionary;
};

const { t } = Astro.props;
---

<section class="relative z-20 flex flex-col w-full items-end justify-end">
  <h1
    class="text-3xl md:text-4xl font-bold text-center mb-2 sm:mb-8 text-accent w-full"
  >
    Misión & Visión
  </h1>

  <div class="max-w-6xl grid grid-cols-1 md:grid-cols-2 gap-14 items-center">
    <img
      src="/images/team.jpeg"
      alt="Imagen Misión"
      class="order-1 w-full h-72 object-cover rounded-xl shadow-lg grayscale"
    />

    <article
      class="order-2 bg-neutral-900/60 p-8 rounded-xl border border-neutral-700 shadow-xl"
    >
      <h2 class="text-3xl font-bold text-accent mb-4">Misión</h2>
      <p class="text-neutral-300 leading-relaxed text-lg">
        {t.about.mission}
      </p>
    </article>

    <article
      class="order-3 md:order-3 bg-neutral-900/60 p-8 rounded-xl border border-neutral-700 shadow-xl"
    >
      <h2 class="text-3xl font-bold text-accent mb-4">Visión</h2>
      <p class="text-neutral-300 leading-relaxed text-lg">
        {t.about.vision}
      </p>
    </article>

    <img
      src="/images/cuervo.jpg"
      alt="Imagen Visión"
      class="order-4 w-full h-72 object-cover rounded-xl shadow-lg"
    />
  </div>
</section>
