---
import RippleCursor from "@/components/Cursor";
import "../styles/global.css";
import Header from "@/components/Navigation/Header.astro";
import Footer from "@/components/Footer/FooterContainer.astro";
import { loadDict } from "@/i18n";
import "@fontsource/outfit";
const lang = (Astro.locals.lang ?? "en") as "en" | "es";
const t = await loadDict(lang);
const prefix = `/${lang}`;
const description =
  lang === "es"
    ? "Sitio creado con Astro para presentar un proyecto moderno, rápido y optimizado."
    : "Website built with Astro to showcase a modern, fast, and optimized project.";
const siteUrl = "https://bblabs.netlify.app";
const ogImage = `${siteUrl}/images/thumbnail.jpg`;
const canonical = `${siteUrl}${Astro.url.pathname}`;
const ogType = "website";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={lang === "es" ? "es_ES" : "en_US"} />
    <meta property="og:title" content="BBLS" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="BBLS" />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <title>BBLS</title>
  </head>
  <body class="bg-bbl-background text-bbl-text bg-black">
    <Header {t} {lang} {prefix} />
    <main>
      <slot />
    </main>
    <Footer {t} {lang} {prefix} />
    <RippleCursor client:load />
  </body>
</html>
