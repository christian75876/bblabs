---
import Layout from "@/layouts/Layout.astro";
import { loadDict } from "@/i18n";
import { getStaticLangPaths, type Lang } from "@/i18n/locales";
import HeaderAbout from "@/components/AboutUS/HeaderAbout.astro";
import Scene3D from "@/components/3d/Scene";
import MisionAndVision from "@/components/AboutUS/MisionAndVision.astro";

export const getStaticPaths = getStaticLangPaths;

const { lang } = Astro.params as { lang: Lang };
const t = await loadDict(lang);
const prefix = `/${lang}`;
---

<Layout {lang} {t} {prefix}>
  <section class="pt-32 px-4 sm:px-8 lg:px-24 mx-auto space-y-10">
    <HeaderAbout {t} />
    <MisionAndVision {t} />
    <Scene3D client:only="react" />
  </section>
</Layout>
