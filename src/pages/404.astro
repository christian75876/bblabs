---
import "../styles/global.css";
import "@fontsource/outfit";

const lang = (Astro.locals.lang ?? "en") as "en" | "es";

const copy = {
  en: {
    title: "We are working on this site",
    subtitle: "This page isn't available yet.",
    body: "We're polishing the experience. Please check back soon.",
    cta: "Go to home",
  },
  es: {
    title: "Estamos trabajando en este sitio",
    subtitle: "Esta página aún no está disponible.",
    body: "Estamos afinando la experiencia. Vuelve pronto.",
    cta: "Ir al inicio",
  },
} as const;

const t = copy[lang];
const homeHref = `/${lang}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="robots" content="noindex" />
    <title>{t.title}</title>
    <style>
      html,
      body {
        cursor: auto;
      }
    </style>
  </head>
  <body class="bg-black text-white">
    <main class="min-h-screen">
      <section class="relative overflow-hidden">
        <div class="absolute inset-0 -z-10">
          <div class="absolute -left-40 top-10 h-96 w-96 rounded-full bg-[#7dfdff]/20 blur-3xl"></div>
          <div class="absolute -right-24 bottom-0 h-80 w-80 rounded-full bg-[#235775]/40 blur-3xl"></div>
          <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/20 to-black"></div>
        </div>

        <div class="mx-auto flex min-h-screen max-w-3xl flex-col items-start justify-center gap-6 px-6 py-20">
          <p class="text-sm uppercase tracking-[0.3em] text-gray-400">
            404 · Maintenance
          </p>
          <h1 class="text-4xl font-semibold leading-tight md:text-5xl">
            {t.title}
          </h1>
          <p class="text-lg text-gray-300 md:text-xl">{t.subtitle}</p>
          <p class="max-w-xl text-base text-white/80 md:text-lg">
            {t.body}
          </p>
          <a
            href={homeHref}
            class="mt-4 inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/5 px-6 py-3 text-sm font-semibold uppercase tracking-[0.2em] text-white transition hover:border-[#7dfdff]/60"
          >
            {t.cta}
          </a>
        </div>
      </section>
    </main>
  </body>
</html>
